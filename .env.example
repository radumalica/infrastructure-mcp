# Copy to .env and fill in real values. .env is gitignored — never commit
# real secrets. Only variables actually referenced by your inventory.yaml
# (via ${VAR} placeholders) need to be set.

GRAFANA_TOKEN=
PROXMOX_TOKEN=

# Only needed if you copied configs/inventory.example.yaml's network
# device entries into your own inventory.yaml as-is:
CORE_ROUTER_PASSWORD=
LEGACY_EDGE_PASSWORD=
SW01_PASSWORD=
ANCIENT_SW_PASSWORD=

# Used by docker-compose.yaml to mount your SSH keys/known_hosts
# read-only into the container (default: ~/.ssh).
SSH_DIR=~/.ssh

# Required for -transport=http (which docker-compose.yaml uses by
# default). Generate one with: openssl rand -hex 32
# Clients must send: Authorization: Bearer <this value>
MCP_HTTP_TOKEN=
